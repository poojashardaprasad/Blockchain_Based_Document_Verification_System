# ====================================================================
# Blockchain Deployment Environment Variables (Hardhat - Sepolia)
# ====================================================================
# Copy this file to .env in the same directory (blockchain/.env)
# Fill in your own credentials manually before running deployment.
# NEVER COMMIT YOUR .env FILE OR REAL PRIVATE KEYS TO VERSION CONTROL!
# ====================================================================

# 1. Sepolia RPC URL (Required for Sepolia testnet deployment)
# Obtain a free RPC URL from Alchemy (https://www.alchemy.com),
# Infura (https://www.infura.io), or use a public testnet RPC.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# 2. Deployer Wallet Private Key (Required for contract deployment)
# 64-character hexadecimal private key of your Ethereum testnet wallet.
# Ensure this account has testnet Sepolia ETH (from a Sepolia faucet) for gas fees.
# Prefix "0x" is optional (the system handles both).
PRIVATE_KEY=your_sepolia_deployer_wallet_private_key_here

# 3. Etherscan API Key (Optional - for verifying smart contract source code on Etherscan)
# Obtain a free API key from https://etherscan.io
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# 4. Local Development (Optional - Ganache)
GANACHE_URL=http://127.0.0.1:7545
GANACHE_PRIVATE_KEY=your_local_ganache_private_key_here
