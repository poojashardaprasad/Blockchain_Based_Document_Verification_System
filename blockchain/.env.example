# ========================================
# Blockchain Deployment Configuration (Hardhat)
# ========================================

# Ethereum Sepolia Testnet RPC URL (Alchemy / Infura / Public)
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Deployer Wallet Private Key (Must have Sepolia testnet ETH from a faucet)
# DO NOT COMMIT YOUR REAL PRIVATE KEY!
PRIVATE_KEY=your_sepolia_wallet_private_key_here

# Etherscan API Key for automated contract source code verification (Optional)
ETHERSCAN_API_KEY=your_etherscan_api_key_optional

# Ganache local RPC (if testing locally)
GANACHE_URL=http://127.0.0.1:7545
GANACHE_PRIVATE_KEY=
