# Dependencies
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Environment Variables & Secrets (CRITICAL)
.env
.env.*
*.env
**/.env
**/.env.*
!*.env.example
!**/.env.example
*.pem
*.key
*.keystore
wallet.json
server/wallet.json

# User Uploads (Never commit uploaded documents)
uploads/
server/uploads/
uploads/*
server/uploads/*
!uploads/.gitkeep
!server/uploads/.gitkeep

# Generated Certificates (Never commit generated certificates)
certificates/
server/certificates/
certificates/*
server/certificates/*
!certificates/.gitkeep
!server/certificates/.gitkeep

# Build Outputs & Bundles
dist/
build/
client/dist/
coverage/
.vercel/

# Blockchain Artifacts
blockchain/artifacts/
blockchain/cache/
blockchain/typechain-types/
.cache/

# IDEs & OS Files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
