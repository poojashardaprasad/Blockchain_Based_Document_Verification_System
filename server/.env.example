# ========================================
# Backend Server Environment Configuration
# ========================================

# Server Port (Render sets this dynamically, default 5001)
PORT=5001
NODE_ENV=production

# ----------------------------------------
# Database Configuration
# Option A: Full Connection String (e.g. Aiven, Railway, PlanetScale)
# DATABASE_URL=mysql://user:password@host:port/doc_verify_db?ssl-mode=REQUIRED

# Option B: Individual Connection Parameters
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=doc_verify_db
DB_SSL=false
# ----------------------------------------

# JWT Authentication
# Generate a secure 64+ char random string
JWT_SECRET=replace_with_secure_random_string_min_32_chars
JWT_EXPIRES_IN=24h

# Blockchain Connection (Ethereum Sepolia Testnet)
# Get a free Sepolia RPC from Alchemy, Infura, QuickNode, or public RPC
# (Both SEPOLIA_RPC_URL and BLOCKCHAIN_RPC_URL are accepted)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
BLOCKCHAIN_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Deployed Smart Contract Address (DocumentRegistry) on Sepolia
CONTRACT_ADDRESS=0x1f22F27dAdAFc8A723193635cB492Cfa9e550731

# Backend Wallet Private Key (with Sepolia testnet ETH for gas fees)
# DO NOT COMMIT ACTUAL PRIVATE KEYS!
PRIVATE_KEY=your_sepolia_wallet_private_key_without_or_with_0x

# Frontend URL (Used for CORS and QR code verification links in PDF certificates)
FRONTEND_URL=https://your-frontend-app.vercel.app

# Allowed CORS Origins (comma-separated or * for public verification)
CORS_ORIGIN=*

# ----------------------------------------
# Persistent Cloud Storage (Optional / Recommended for Cloud Hosting)
# Compatible with AWS S3, Cloudflare R2, MinIO, Supabase Storage
# ----------------------------------------
# S3_BUCKET=your-bucket-name
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=your_access_key_id
# S3_SECRET_ACCESS_KEY=your_secret_access_key
# STORAGE_DIR=/var/data/storage # Fallback local persistent disk path
